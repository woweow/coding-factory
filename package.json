{
  "name": "statemachines",
  "version": "1.0.0",
  "description": "Factory for coding factories: register workflows, later run them on Temporal via Cursor Cloud agents",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "server": "tsx src/server.ts",
    "dev": "tsx temporal/client.ts",
    "temporal": "tsx temporal/client.ts",
    "temporal:worker": "tsx temporal/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 src/domain/validate.test.ts src/storage/sqlite.test.ts src/http/register.test.ts temporal/workflows.test.ts",
    "test:factory": "tsx --test --test-concurrency=1 src/domain/validate.test.ts src/storage/sqlite.test.ts src/http/register.test.ts"
  },
  "author": "woweow",
  "license": "ISC",
  "dependencies": {
    "@temporalio/activity": "^1.22.0",
    "@temporalio/client": "^1.22.0",
    "@temporalio/envconfig": "^1.22.0",
    "@temporalio/worker": "^1.22.0",
    "@temporalio/workflow": "^1.22.0",
    "@typeonce/effect-machine": "^0.18.0",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.22.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "5.9"
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/woweow/coding-factory/src/domain/workflow.schema.json",
  "title": "Coding factory workflow definition",
  "description": "Register-time JSON for a coding factory workflow. Runtime fields (cursorAgentId / bc- handle, temporalWorkflowId, currentStepId) live on workflow_runs, not in this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "entry", "agent", "steps"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "entry": { "type": "string", "minLength": 1 },
    "agent": { "$ref": "#/$defs/cursorCloudCreateOptions" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "modelParameterValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "modelSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "params": {
          "type": "array",
          "items": { "$ref": "#/$defs/modelParameterValue" }
        }
      }
    },
    "cloudRepo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "startingRef": { "type": "string", "minLength": 1 },
        "prUrl": { "type": "string", "minLength": 1 }
      }
    },
    "cloudEnv": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["cloud", "pool", "machine"] },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "cloudAgentOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repos"],
      "properties": {
        "env": { "$ref": "#/$defs/cloudEnv" },
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/cloudRepo" }
        },
        "workOnCurrentBranch": { "type": "boolean" },
        "autoCreatePR": { "type": "boolean" },
        "openAsCursorGithubApp": { "type": "boolean" },
        "skipReviewerRequest": { "type": "boolean" },
        "envVars": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "cursorCloudCreateOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "cloud"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "model": { "$ref": "#/$defs/modelSelection" },
        "mode": { "enum": ["agent", "plan"] },
        "cloud": { "$ref": "#/$defs/cloudAgentOptions" }
      }
    },
    "outputMatch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "always" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "key", "value"],
          "properties": {
            "kind": { "const": "equals" },
            "key": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string" },
        "match": { "$ref": "#/$defs/outputMatch" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "systemPrompt": { "type": "string" },
        "mode": { "enum": ["agent", "plan"] },
        "routes": {
          "type": "array",
          "items": { "$ref": "#/$defs/route" }
        }
      }
    }
  }
}
